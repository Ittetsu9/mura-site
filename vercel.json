{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo skip",
  "buildCommand": "echo skip",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
